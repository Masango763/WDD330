<%- include('partials/header') %>
    <main class="content-container">
        <h1><%= project.title %></h1>
        <p class="org-tag">Sponsored by: <strong><%= project.organization_name %></strong></p>
        
        <div class="project-meta">
            <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
            <p><strong>Location:</strong> <%= project.location %></p>
        </div>

        <section class="description-block">
            <h3>About this Project</h3>
            <p><%= project.description %></p>
        </section>

        <p class="contact-footer">Inquiries: <a href="mailto:<%= project.contact_email %>"><%= project.contact_email %></a></p>
    </main>
<%- include('partials/footer') %>
